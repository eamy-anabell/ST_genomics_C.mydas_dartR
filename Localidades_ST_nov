# GRAFICAR ANCESTRÍA CON GGPLOT2 NATIVO (LETRA GRANDE)
# ============================================================

library(pophelper)
library(ggplot2)
library(dplyr)
library(tidyr)

# 1. Ruta exacta de los resultados
dir_results <- "C:/Users/eamy1/Downloads/ST/data/localidades/structure/ch_localidades/localidades/Results"

# 2. Leer y alinear archivos de resultados Q
files_structure <- list.files(
  path       = dir_results, 
  pattern    = "_f$", 
  full.names = TRUE
)
q_list <- readQ(files_structure)
q_list_aligned <- alignK(q_list)

# 3. Función para convertir un objeto Q a dataframe de ggplot

q_to_df <- function(q_obj, name_run) {
  df <- as.data.frame(q_obj)
  df$Ind <- rownames(df)
  df$Run <- name_run
  df$K_val <- paste0("K = ", ncol(q_obj))
  
  # Pasar a formato largo (tidy)
  df_long <- pivot_longer(
    df, 
    cols = starts_with("Cluster"), 
    names_to = "Cluster", 
    values_to = "Ancestry"
  )
  return(df_long)
}

# 4. Procesar todas las corridas MCMC
all_dfs <- lapply(seq_along(q_list_aligned), function(i) {
  q_to_df(q_list_aligned[[i]], names(q_list_aligned)[i])
})

df_master <- bind_rows(all_dfs)

# 5. Generar y exportar gráficos individuales con LETRA MUY GRANDE
unique_runs <- unique(df_master$Run)

for (run_id in unique_runs) {
  
  sub_df <- df_master %>% filter(Run == run_id)
  k_label <- unique(sub_df$K_val)
  
  p <- ggplot(sub_df, aes(x = Ind, y = Ancestry, fill = Cluster)) +
    geom_bar(stat = "identity", width = 1) +
    facet_wrap(~ K_val, scales = "free_x") +
    scale_y_continuous(expand = c(0, 0)) +
    theme_minimal() +
    labs(
      title = paste0("Análisis de Estructura Genética - ", k_label),
      y = "Proporción de Ancestría (Q)",
      x = "Individuos / Localidades"
    ) +
    theme(
      # --- TAMAÑO DE FUENTE Y TÍTULOS ---
      plot.title      = element_text(size = 22, face = "bold", hjust = 0.5, margin = margin(b = 10)),
      strip.text      = element_text(size = 20, face = "bold"),   # Letra de K gigante en la franja superior
      axis.title.y    = element_text(size = 16, face = "bold"),
      axis.title.x    = element_text(size = 16, face = "bold"),
      axis.text.y     = element_text(size = 14, color = "black"),
      axis.text.x     = element_text(size = 10, angle = 90, vjust = 0.5, hjust = 1, color = "black"),
      legend.position = "none",                                    # Oculta la leyenda redundante de clústeres
      panel.spacing   = unit(1, "lines")
    )
  
  # Nombre único para cada imagen PNG
  file_name <- file.path(dir_results, paste0("Plot_LetraGrande_", run_id, ".png"))
  
  ggsave(
    filename = file_name, 
    plot     = p, 
    width    = 14, 
    height   = 5, 
    dpi      = 300
  )
}

cat("\n======================================================\n")
cat("¡ÉXITO! Se exportaron las imágenes con letra gigante en:\n")
cat(dir_results, "\n")
cat("======================================================\n")




