# ------------------------------------------------------------------------------
# FILTRO 1: EQUILIBRIO DE HARDY-WEINBERG (HWE)
# ------------------------------------------------------------------------------
# Elimina loci que se desvían de HWE por población/localidad (FDR = 0.05)
gl_hwe <- gl.filter.hwe(gl_preNeut, subset = "each", alpha_val = 0.05,
                        multi_comp = TRUE, multi_comp_method = "fdr", verbose = 3)

cat("Loci retenidos tras filtro de HWE:", nLoc(gl_hwe), "\n")
