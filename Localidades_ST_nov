# 1. PAQUETES Y DIRECTORIO
library(dartR)
library(adegenet)
library(ggplot2)
library(reshape2)
library(openxlsx)

dir_general <- "C:/Users/eamy1/Downloads/ST/data/localidades"


# ============================================================
# 2. CARGAR DATOS NEUTRALES
# ============================================================

gl_Neut <- readRDS(
  file.path(dir_general, "gl_Neut_localidades.rds")
)

