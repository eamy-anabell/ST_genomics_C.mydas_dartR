print(nLoc(gl_Neut))

# Verificar número de localidades
cat("\nNúmero de localidades:\n")
print(nPop(gl_Neut))


# ============================================================
# 3. CALCULAR FST POR PARES
# ============================================================

set.seed(132)

fst <- gl.fst.pop(
  gl_Neut,
  nboots = 1000,
  percent = 95
)


# ============================================================
# 4. EXTRAER MATRICES
# ============================================================

fst_mat <- as.matrix(fst$Fsts)
p_mat <- as.matrix(fst$Pvalues)

# Verificar que las matrices tengan las mismas dimensiones
if (!identical(dim(fst_mat), dim(p_mat))) {
  stop("Las matrices FST y Pvalues tienen dimensiones diferentes.")
}

# Verificar nombres de localidades
if (!setequal(rownames(fst_mat), rownames(p_mat)) ||
    !setequal(colnames(fst_mat), colnames(p_mat))) {
  stop("Las matrices FST y Pvalues no tienen las mismas localidades.")
}

# Alinear matriz de valores p con la matriz FST
p_mat <- p_mat[
  rownames(fst_mat),
  colnames(fst_mat),
  drop = FALSE
]

cat("\nMatriz FST:\n")
print(round(fst_mat, 4))

cat("\nMatriz de valores p:\n")
print(round(p_mat, 4))


# ============================================================
# 5. CREAR TABLA DE COMPARACIONES POR PARES
# ============================================================

# Se utiliza solo el triángulo inferior
# para evitar comparaciones duplicadas.

fst_inf <- fst_mat
p_inf <- p_mat

fst_inf[upper.tri(fst_inf, diag = TRUE)] <- NA
p_inf[upper.tri(p_inf, diag = TRUE)] <- NA

df_fst <- melt(
  fst_inf,
  varnames = c("Pop1", "Pop2"),
  value.name = "FST",
  na.rm = TRUE
)

df_p <- melt(
  p_inf,
  varnames = c("Pop1", "Pop2"),
  value.name = "Pvalue",
  na.rm = TRUE
)

# Unir FST y valores p
tabla_pares <- merge(
  df_fst,
  df_p,
  by = c("Pop1", "Pop2")
)

# Clasificar significancia
tabla_pares$Significancia <- ifelse(
  is.na(tabla_pares$Pvalue),
  NA_character_,
  ifelse(
    tabla_pares$Pvalue < 0.001, "***",
    ifelse(
      tabla_pares$Pvalue < 0.01, "**",
      ifelse(
        tabla_pares$Pvalue < 0.05, "*", "ns"
      )
    )
  )
)

# Crear etiqueta para gráfico
tabla_pares$Etiqueta <- paste0(
  sprintf("%.3f", tabla_pares$FST),
  "\n",
  tabla_pares$Significancia
)

