# 5. FST POR PARES - CLÚSTERES
# ============================================================

library(dartR)
library(adegenet)
library(ggplot2)
library(openxlsx)

orden_pob <- c("ME", "CR", "Sur")

set.seed(123)

fst <- gl.fst.pop(
  gl_clusteres,
  nboots = 1000,
  percent = 95
)

# ============================================================
# 6. EXTRAER Y COMPLETAR MATRICES
# ============================================================

fst_mat <- as.matrix(fst$Fsts)
p_mat <- as.matrix(fst$Pvalues)

# Verificar nombres de clústeres
stopifnot(
  all(orden_pob %in% rownames(fst_mat)),
  all(orden_pob %in% colnames(fst_mat)),
  all(orden_pob %in% rownames(p_mat)),
  all(orden_pob %in% colnames(p_mat))
)

# Ordenar matrices
fst_mat <- fst_mat[orden_pob, orden_pob]
p_mat <- p_mat[orden_pob, orden_pob]

cat("\nMatriz FST original:\n")
print(round(fst_mat, 4))

cat("\nMatriz de valores p original:\n")
print(round(p_mat, 4))

#--------------------------------------------------
# Completar valores desde ambos triángulos
#--------------------------------------------------

completar_matriz <- function(mat) {
  
  for (i in seq_len(nrow(mat))) {
    
    for (j in seq_len(ncol(mat))) {
      
      if (
        i != j &&
        is.na(mat[i, j]) &&
        !is.na(mat[j, i])
      ) {
        mat[i, j] <- mat[j, i]
      }
      
    }
  }
  
  diag(mat) <- NA_real_
  
  return(mat)
}

fst_completa <- completar_matriz(fst_mat)
p_completa <- completar_matriz(p_mat)

cat("\nMatriz FST completa:\n")
print(round(fst_completa, 4))

cat("\nMatriz de valores p completa:\n")
print(round(p_completa, 4))

# Verificar simetría
stopifnot(
  isTRUE(all.equal(
    fst_completa,
    t(fst_completa)
  )),
  isTRUE(all.equal(
    p_completa,
    t(p_completa)
  ))
)

# ============================================================
# 7. CREAR TABLA DE COMPARACIONES POR PARES
# ============================================================

# Definir las tres comparaciones únicas
pares <- data.frame(
  Pop1 = c("ME", "ME", "CR"),
  Pop2 = c("CR", "Sur", "Sur")
)

# Extraer FST y valores p
tabla_pares <- pares

tabla_pares$FST <- mapply(
  function(a, b) fst_completa[a, b],
  tabla_pares$Pop1,
  tabla_pares$Pop2
)

tabla_pares$Pvalue <- mapply(
  function(a, b) p_completa[a, b],
  tabla_pares$Pop1,
  tabla_pares$Pop2
)

# Verificar que las tres comparaciones tengan FST
stopifnot(
  !anyNA(tabla_pares$FST)
)

cat("\nComparaciones por pares:\n")
print(tabla_pares)

# ============================================================
# 8. SIGNIFICANCIA ESTADÍSTICA
# ============================================================

tabla_pares$Significancia <- ifelse(
  is.na(tabla_pares$Pvalue),
  "",
  ifelse(
    tabla_pares$Pvalue < 0.001, "***",
    ifelse(
      tabla_pares$Pvalue < 0.01, "**",
      ifelse(
        tabla_pares$Pvalue < 0.05, "*", ""
      )
    )
  )
)

# Etiqueta: FST + asteriscos
tabla_pares$Etiqueta <- paste0(
  sprintf("%.3f", tabla_pares$FST),
  tabla_pares$Significancia
)

# Ordenar factores
tabla_pares$Pop1 <- factor(
  tabla_pares$Pop1,
  levels = orden_pob
)

tabla_pares$Pop2 <- factor(
  tabla_pares$Pop2,
  levels = orden_pob
)

cat("\nTabla final de comparaciones:\n")
print(tabla_pares)


# ============================================================
# 9. HEATMAP FST - TRIÁNGULO ESCALONADO
# ============================================================

library(ggplot2)

# Mantener solo las comparaciones entre clústeres
# Filas: ME, CR
# Columnas: CR, Sur

tabla_pares$Pop1 <- factor(
  as.character(tabla_pares$Pop1),
  levels = c("ME", "CR")
)

tabla_pares$Pop2 <- factor(
  as.character(tabla_pares$Pop2),
  levels = c("CR", "Sur")
)

# Crear heatmap
p_fst <- ggplot(
  tabla_pares,
  aes(
    x = Pop2,
    y = Pop1,
    fill = FST
  )
) +
  
  geom_tile(
    color = "white",
    linewidth = 0.8,
    width = 1,
    height = 1
  ) +
  
  geom_text(
    aes(label = Etiqueta),
    color = "black",
    size = 6,
    fontface = "bold"
  ) +
  
  scale_fill_gradient(
    low = "#E0F2FE",
    high = "#0369A1",
    name = expression(F[ST])
  ) +
  
  # Solo columnas con comparaciones
  scale_x_discrete(
    limits = c("CR", "Sur"),
    drop = FALSE,
    expand = expansion(mult = 0)
  ) +
  
  # Solo filas con comparaciones
  scale_y_discrete(
    limits = c("CR", "ME"),
    drop = FALSE,
    expand = expansion(mult = 0)
  ) +
  
  coord_fixed() +
  
  labs(
    title = expression(
      paste(
        "Diferenciación genética por pares (",
        F[ST],
        ")"
      )
    ),
    subtitle = "* p < 0.05, ** p < 0.01, *** p < 0.001",
    x = NULL,
    y = NULL
  ) +
  
  theme_minimal() +
  
  theme(
    plot.title = element_text(
      face = "bold",
      size = 18,
      hjust = 0.5
    ),
    
    plot.subtitle = element_text(
      size = 13,
      hjust = 0.5
    ),
    
    axis.text.x = element_text(
      angle = 45,
      hjust = 1,
      size = 15,
      color = "black"
    ),
    
    axis.text.y = element_text(
      size = 15,
      color = "black"
    ),
    
    legend.title = element_text(size = 15),
    legend.text = element_text(size = 13),
    
    panel.grid = element_blank(),
    
    panel.border = element_blank(),
    
    plot.background = element_rect(
      fill = "white",
      color = NA
    )
  )

print(p_fst)

