# 1. Carga estandarizada de las 3 listas de outliers (vectores limpios)
bs_out <- if (file.exists(file.path(dir_bayescan, "bayescan_outliers_clusteres.txt"))) {
  scan(file.path(dir_bayescan, "bayescan_outliers_clusteres.txt"), what = "character", quiet = TRUE)
} else character(0)

pcadapt_out <- if (file.exists(file.path(dir_pcadapt, "pcadapt_outliers_clusteres.txt"))) {
  scan(file.path(dir_pcadapt, "pcadapt_outliers_clusteres.txt"), what = "character", quiet = TRUE)
} else character(0)

fsthet_out <- if (file.exists(file.path(dir_fsthet, "fsthet_outliers_clusteres.txt"))) {
  scan(file.path(dir_fsthet, "fsthet_outliers_clusteres.txt"), what = "character", quiet = TRUE)
} else character(0)

# 2. Conteo de frecuencias por locus
todos_outliers <- c(bs_out, pcadapt_out, fsthet_out)
tabla_conteo   <- table(todos_outliers)

# Categorización bajo criterio conservador:
# (i)   Outliers Candidatos: detectados en >= 2 programas
loci_outliers_final <- names(tabla_conteo[tabla_conteo >= 2])

# (ii)  Zona Gris: detectados en exactamente 1 programa (se descartan)
loci_zona_gris      <- names(tabla_conteo[tabla_conteo == 1])

# (iii) Loci Neutros candidatos: detectados en 0 programas
todos_los_loci      <- locNames(gl6)
loci_neutros_final  <- setdiff(todos_los_loci, c(loci_outliers_final, loci_zona_gris))

# 3. Filtrado y guardado seguro de objetos genlight

# A. Dataset de Outliers (>= 2 programas)
if (length(loci_outliers_final) > 0) {
  gl6_OUTLIERS <- gl.keep.loc(gl6, loc.list = loci_outliers_final, verbose = 0)
  saveRDS(gl6_OUTLIERS, file.path(dir_general, "gl6_OUTLIERS_conservador_clusteres.rds"))
  cat("Genlight OUTLIERS guardado:", nLoc(gl6_OUTLIERS), "loci.\n")
} else {
  cat("Atención: Ningún SNP fue detectado simultáneamente en >= 2 programas.\n")
  gl6_OUTLIERS <- NULL
}

# B. Dataset Neutro (se remueven outliers y loci de zona gris)
if (length(c(loci_outliers_final, loci_zona_gris)) > 0) {
  gl_preNeut <- gl.drop.loc(gl6, loc.list = c(loci_outliers_final, loci_zona_gris), verbose = 0)
} else {
  gl_preNeut <- gl6
}
saveRDS(gl_preNeut, file.path(dir_general, "gl_preNeut_conservador_clusteres.rds"))
cat("Genlight NEUTRO guardado:", nLoc(gl_preNeut), "loci.\n")


