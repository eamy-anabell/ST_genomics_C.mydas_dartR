# ==============================================================================
# METODO 1: BAYESCAN
# ==============================================================================

# A. Exportar el archivo al formato .gest directamente en la carpeta de BayeScan
gl2bayescan(gl6, outfile = "datos_bayescan.gest", outpath = dir_bayescan)

# B. Lectura y procesamiento de la salida de BayeScan
# Ruta al archivo con el sufijo generado por tu corrida
ruta_bayescan_out <- file.path(dir_bayescan, "output_loc_fst_fst.txt")

if (file.exists(ruta_bayescan_out)) {
  bs_res <- read.table(ruta_bayescan_out, header = TRUE)
  bs_res$LocusName <- locNames(gl6)
  
  # Filtrar outliers (qval < 0.05)
  bs_outliers_df <- bs_res %>% filter(qval < 0.05)
  bs_outliers_names <- bs_outliers_df$LocusName
  
  # Guardar lista de outliers especificando "clusteres"
  write.table(
    bs_outliers_names,
    file = file.path(dir_bayescan, "bayescan_outliers_clusteres.txt"),
    row.names = FALSE, col.names = FALSE, quote = FALSE
  )
  
  cat("Outliers detectados por BayeScan (qval < 0.05):", length(bs_outliers_names), "\n")
  
  # Exportar gráfico en la carpeta de BayeScan
  png(file.path(dir_bayescan, "BayeScan_plot_clusteres.png"), width = 1920, height = 1080, res = 300)
  bs_res$log10_qval <- -log10(bs_res$qval)
  plot(bs_res$fst, bs_res$log10_qval,
       xlab = "FST", ylab = "-log10(q-value)",
       main = "BayeScan Clusteres: Candidate Outliers (FDR = 0.05)",
       pch = 20, col = "grey")
  abline(h = -log10(0.05), col = "red", lty = 2, lwd = 2)
  points(bs_res$fst[bs_res$qval < 0.05], 
         bs_res$log10_qval[bs_res$qval < 0.05], 
         col = "red", pch = 19)
  dev.off()
} else {
  warning("No se encontró el archivo output_loc_fst_fst.txt en la carpeta de BayeScan.")
  bs_outliers_names <- character(0)
}

# ==============================================================================
# METODO 2: PCADAPT
# ==============================================================================

# A. Convertir genotipos e importar a pcadapt
gl_mat <- as.matrix(gl6)
gl6_pcadapt <- read.pcadapt(t(gl_mat), type = "pcadapt")

# B. Evaluación de K y guardado del Screeplot
x_eval <- pcadapt(gl6_pcadapt, K = 10, min.maf = 0.01)

png(file.path(dir_pcadapt, "PCAdapt_screeplot_clusteres_sin_maf.png"), width = 1920, height = 1080, res = 300)
plot(x_eval, option = "screeplot")
dev.off()

# C. Ejecutar PCAdapt con K seleccionado (ej. K = 4) y extraer outliers
x <- pcadapt(gl6_pcadapt, K = 4, min.maf = 0.01)
qval <- qvalue(x$pvalues)$qvalues
out_pcadapt_idx <- which(qval < 0.05)
out_pcadapt_names <- locNames(gl6)[out_pcadapt_idx]

# D. Guardar lista de outliers en la carpeta pcadapt
write.table(
  out_pcadapt_names,
  file = file.path(dir_pcadapt, "pcadapt_outliers_clusteres_sin_maf.txt"),
  row.names = FALSE, col.names = FALSE, quote = FALSE
)

cat("Outliers detectados por PCAdapt:", length(out_pcadapt_names), "\n")


# ==============================================================================
# METODO 3: FSTHET
# ==============================================================================

# A. Preparar matriz compatible
gi6 <- gl2gi(gl6, verbose = 0)
df_fsthet <- genind2df(gi6, sep = "/")
df_fsthet <- cbind(pop = pop(gl6), df_fsthet)

# B. Ejecutar fsthet
fsts_res <- fsthet(df_fsthet, alpha = 0.05)

# C. Extraer outliers
if ("outlier" %in% colnames(fsts_res)) {
  out_fsthet_df <- fsts_res %>% filter(outlier == TRUE)
} else if ("Outlier" %in% colnames(fsts_res)) {
  out_fsthet_df <- fsts_res %>% filter(Outlier == TRUE)
} else if ("outliers" %in% colnames(fsts_res)) {
  out_fsthet_df <- fsts_res %>% filter(outliers == TRUE)
} else {
  out_fsthet_df <- fsts_res %>% filter(Fst < CI.low | Fst > CI.high)
}

out_fsthet_names <- as.character(out_fsthet_df$Locus)

# D. Guardar lista de outliers y resultados completos en la carpeta fsthet
write.table(
  out_fsthet_names,
  file = file.path(dir_fsthet, "fsthet_outliers_clusteres_sin_maf.txt"),
  row.names = FALSE, col.names = FALSE, quote = FALSE
)

write.table(
  fsts_res,
  file = file.path(dir_fsthet, "fsthet_resultados_clusteres_sin_maf.txt"),
  row.names = FALSE, sep = "\t", quote = FALSE
)

cat("Outliers detectados por Fsthet:", length(out_fsthet_names), "\n")


