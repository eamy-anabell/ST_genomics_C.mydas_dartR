## FILTROS DE CALIDAD (dartR) PARA EL MORFOTIPO NEGRO (gl_negro)
## ==============================================================================

# 1. Filtrado por reproducibilidad (RepAvg = 1.00)
# Se conservan únicamente los loci con reproducibilidad perfecta
gl1 <- gl.filter.reproducibility(gl_negro, threshold = 1.00, verbose = 3)
cat("SNPs tras filtro de reproducibilidad:", nLoc(gl1), "\n")

# 2. Filtrado por Frecuencia del Alelo Menor (MAF)
# Filtra los alelos raros (por defecto en dartR el umbral es MAF >= 0.01 o según configuración de paquete)
#gl2 <- gl.filter.maf(gl1, verbose = 3)
#cat("SNPs tras filtro de MAF:", nLoc(gl2), "\n")

# 3. Filtrado por Call Rate a nivel de Loci (loc)
# Retiene loci con al menos el 85% de genotipado (máximo 15% de datos faltantes)
gl3 <- gl.filter.callrate(gl1, method = "loc", threshold = 0.85, verbose = 3)
cat("SNPs tras filtro de Call Rate por locus:", nLoc(gl3), "\n")
gl3
# 4. Filtrado por Call Rate a nivel de Individuo (ind)
# Retiene individuos con al menos el 90% de genotipado (máximo 10% de datos faltantes)
gl4 <- gl.filter.callrate(gl3, method = "ind", threshold = 0.90, recalc = TRUE, mono.rm = TRUE, verbose = 3)
cat("Individuos retenidos:", nInd(gl4), "\n")
cat("SNPs retenidos:", nLoc(gl4), "\n")

# 5. Eliminación de loci monomórficos
# Remueve cualquier locus que se haya vuelto fijo tras remover individuos o SNPs
gl5 <- gl.filter.monomorphs(gl4, verbose = 3)
cat("SNPs tras remover monomórficos:", nLoc(gl5), "\n")

# 6. Eliminación de SNPs secundarios
# Conserva solo un SNP por secuencia/tag de DArT para evitar ligamiento estricto
gl6 <- gl.filter.secondaries(gl5, verbose = 3)
cat("SNPs finales únicos (sin secundarios):", nLoc(gl6), "\n")

