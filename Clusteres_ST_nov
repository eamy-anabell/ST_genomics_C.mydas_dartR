#--------------------------------------------------
# 12. ALELOS PRIVADOS
#--------------------------------------------------

# Solo se consideran loci con datos observados
# en los tres clústeres

validos <- rowSums(
  is.na(frecuencias)
) == 0

calcular_privados <- function(p) {

  otras <- setdiff(orden_pob, p)

  # Alelo codificado como 2:
  # presente en p y ausente en los demás
  privados_alt <- (
    frecuencias[, p] > 0 &
    rowSums(
      frecuencias[, otras, drop = FALSE] > 0
    ) == 0
  )

  # Alelo codificado como 0:
  # presente en p y ausente en los demás
  privados_ref <- (
    frecuencias[, p] < 1 &
    rowSums(
      frecuencias[, otras, drop = FALSE] < 1
    ) == 0
  )

  data.frame(
    Poblacion = p,
    Indicador = "Private alleles",
    Valor = sum(
      validos & (privados_alt | privados_ref),
      na.rm = TRUE
    ),
    SD = NA_real_
  )
}

datos_privados <- bind_rows(
  lapply(orden_pob, calcular_privados)
)

