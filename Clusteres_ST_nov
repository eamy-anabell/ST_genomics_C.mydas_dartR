#--------------------------------------------------
# 10. FRECUENCIAS ALÉLICAS POR CLÚSTER
#--------------------------------------------------

# Frecuencia del alelo codificado como 2
# Se utiliza únicamente la información disponible

frecuencias <- sapply(
  orden_pob,
  function(p) {

    datos <- geno[
      poblaciones == p,
      ,
      drop = FALSE
    ]

    n_observados <- colSums(!is.na(datos))

    frec <- colSums(
      datos,
      na.rm = TRUE
    ) / (2 * n_observados)

    frec[n_observados == 0] <- NA_real_

    frec
  }
)

colnames(frecuencias) <- orden_pob

#--------------------------------------------------
# 11. ALELOS RAROS
#--------------------------------------------------

# Criterio: frecuencia alélica > 0 y < 0.05
# Se consideran ambos alelos de cada SNP

calcular_raros <- function(p) {

  frec <- frecuencias[, p]

  maf <- pmin(
    frec,
    1 - frec
  )

  data.frame(
    Poblacion = p,
    Indicador = "Rare alleles",
    Valor = sum(
      maf > 0 & maf < 0.05,
      na.rm = TRUE
    ),
    SD = NA_real_
  )
}

datos_raros <- bind_rows(
  lapply(orden_pob, calcular_raros)
)

