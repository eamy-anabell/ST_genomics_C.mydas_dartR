# ==============================================================================
# PIPELINE DE OUTLIERS CON PCADAPT Y FSTHET PARA EL OBJETO 'gl6'
# ==============================================================================

library(dartR)
library(pcadapt)
library(fsthet)
library(qvalue)
library(dplyr)

# 1. Cargar el objeto gl6
gl6 <- readRDS("gl6_filtrado_call.rds")

# Crear carpeta para guardar resultados
if (!dir.exists("Resultados_Outliers")) {
  dir.create("Resultados_Outliers")
}

# ==============================================================================
# METODO 1: PCADAPT (Fast Principal Component Analysis)
# Metodología: MAF = 0.01 y q-value < 0.05
# ==============================================================================

# A. Convertir la matriz de genotipos (0,1,2) directamente a pcadapt
gl_mat <- as.matrix(gl6)
gl6_pcadapt <- read.pcadapt(t(gl_mat), type = "pcadapt")

# B. Evaluar componentes principales (Screeplot para confirmar K)
x_eval <- pcadapt(gl6_pcadapt, K = 10, min.maf = 0.01)
plot(x_eval, option = "screeplot")

# C. Ejecutar PCAdapt con K elegido (ejemplo K = 4) y MAF = 0.01
x <- pcadapt(gl6_pcadapt, K = 4, min.maf = 0.01)

# D. Transformar p-values a q-values y seleccionar outliers
qval <- qvalue(x$pvalues)$qvalues
out_pcadapt_idx <- which(qval < 0.05)

# E. Nombres de los SNPs outliers de PCAdapt
out_pcadapt_names <- locNames(gl6)[out_pcadapt_idx]

# F. Guardar lista de outliers de PCAdapt
write.table(
  out_pcadapt_names,
  file = "./Resultados_Outliers/gl6_pcadapt_outliers.txt",
  row.names = FALSE, col.names = FALSE, quote = FALSE
)

cat("Outliers detectados por PCAdapt:", length(out_pcadapt_names), "\n")

#Outliers detectados por Fsthet: 1216 

# ==============================================================================
# METODO 2: FSTHET (Relationship Fst - Heterozygosity) - CORREGIDO
# ==============================================================================

# A. Preparar la estructura de datos compatible
gi6 <- gl2gi(gl6, verbose = 0)
df_fsthet <- genind2df(gi6, sep = "/")

# fsthet requiere la columna 'pop' al inicio y sin la columna id
df_fsthet <- cbind(pop = pop(gl6), df_fsthet)

# 1. Ejecutar fsthet
fsts_res <- fsthet(df_fsthet, alpha = 0.05)

# 2. Ver las columnas exactas que generó la función
colnames(fsts_res)

# 3. Inspeccionar las primeras filas para verificar los nombres
head(fsts_res)

#==========================OBTENER OUTLIERS=============================
library(dplyr)

# Identificar automáticamente la columna de outliers o hacer el filtro directo
if ("outlier" %in% colnames(fsts_res)) {
  out_fsthet_df <- fsts_res %>% filter(outlier == TRUE)
} else if ("Outlier" %in% colnames(fsts_res)) {
  out_fsthet_df <- fsts_res %>% filter(Outlier == TRUE)
} else if ("outliers" %in% colnames(fsts_res)) {
  out_fsthet_df <- fsts_res %>% filter(outliers == TRUE)
} else {
  # Si devuelve CI (intervalos de confianza) directamente
  out_fsthet_df <- fsts_res %>% filter(Fst < CI.low | Fst > CI.high)
}

# Obtener nombres de los marcadores
out_fsthet_names <- as.character(out_fsthet_df$Locus)

# Guardar la lista de outliers de Fsthet
write.table(
  out_fsthet_names,
  file = "./Resultados_Outliers/gl6_fsthet_outliers.txt",
  row.names = FALSE, col.names = FALSE, quote = FALSE
)

cat("Outliers detectados por Fsthet:", length(out_fsthet_names), "\n")

#Outliers detectados por PCAdapt: 5412 
  
  # ==============================================================================
# CONSOLIDACIÓN Y CLASIFICACIÓN CONSERVADORA DE LOCI OUTLIERS/NEUTROS
# Metodología: 
#   (i)   Outliers: detectados por AL MENOS 2 programas.
#   (ii)  Neutros: NO detectados por ningún programa (asumidos neutros).
#   (iii) Zona Gris: detectados por SOLO 1 programa (descartados).
# ==============================================================================

library(dartR)
library(dplyr)

# 1. Cargar las 3 listas de outliers guardadas previamente
bs_out     <- scan("./Resultados_Outliers/gl6_bayescan_outliers.txt", what = "character")
pcadapt_out <- scan("./Resultados_Outliers/gl6_pcadapt_outliers.txt", what = "character")
fsthet_out  <- scan("./Resultados_Outliers/gl6_fsthet_outliers.txt", what = "character")

# 2. Vector con todos los loci observados como outliers y conteo por frecuencia
todos_outliers <- c(bs_out, pcadapt_out, fsthet_out)
tabla_conteo   <- table(todos_outliers)

#  Filters for neutral dataset ---------------------------------------------
# --- 1. Remove outliers ---

# (i) Outliers Candidatos: Presentes en >= 2 métodos
loci_outliers_final <- names(tabla_conteo[tabla_conteo >= 2])

# (iii) Zona Gris: Presentes en exactamente 1 método (se descartan de ambos conjuntos)
loci_zona_gris <- names(tabla_conteo[tabla_conteo == 1])

# (ii) Loci Neutros: Todos los loci de gl6 que NUNCA fueron detectados por ningún método
todos_los_loci <- locNames(gl6)
loci_neutros_final <- setdiff(todos_los_loci, c(loci_outliers_final, loci_zona_gris))


# 3. Filtrar el objeto genlight en R usando gl.keep.loc()
gl6_OUTLIERS <- gl.keep.loc(gl6, loc.list = loci_outliers_final, verbose = 0)
gl_preNeut   <- gl.keep.loc(gl6, loc.list = loci_neutros_final, verbose = 0)

# Guardar los datasets resultantes
saveRDS(gl6_OUTLIERS, "gl6_OUTLIERS_conservador.rds")
saveRDS(gl_preNeut, "gl_preNeut_conservador.rds")


