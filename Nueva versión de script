# 2) Filter by reproducibility (RepAvg)
gl1 <- gl.filter.reproducibility(gl_NCEPGL, threshold = 1.00, verbose = 3) #siempre 0.99
gl1 #55,454 SNPs #55,454 SNPs

# Genlight object
gl2 <- gl.filter.maf(gl1, verbose   = 3)

gl2 #39,192 SNPs #30,810 SNPs

# Si pones --maf 0.05, le estás diciendo a VCFtools: "Solo quédate con los SNPs
#donde el alelo raro aparezca en al menos el 5% del total de alelos de la población".
#En nuestro caso, con 95 individuos (que son 190 alelos, porque cada individuo es 
#diploide), un MAF de 0.05 significa que el SNP debe aparecer al menos en 9 o 10 
#alelos (aprox. 5 individuos heterocigotos).
# --maf 0.05, indica: "Solo quédate con los SNPs donde el alelo raro aparezca en al menos el 5% del total de alelos de la población".

# ) Filter by locus
gl3 <- gl.filter.callrate(gl2, method = "loc", threshold = 0.85, verbose=3) #remocion de loci con mas de 10% de datos faltantes
gl3 # 11,848 SNPs loci #19,606


# 4) Filter per individual
gl4 <- gl.filter.callrate(gl3, method="ind", threshold = 0.90, recalc = TRUE, mono.rm = TRUE)  #remocion de individuos con mas de 15% de datos faltantes.
