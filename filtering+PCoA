gl6_3 <- readRDS("C:/Users/eamy1/Downloads/ST/data/gl6_v3_filtrado_call.rds")

library(ggplot2)
library(ggthemes)
library(dplyr) 

# --- PREPARACIÓN DE DATOS ----------------------------------------------
gl6_imp <- gl.impute(gl6_3, method = "neighbour")
pcoa_res <- gl.pcoa(gl6_imp, nfactors = 5)

df_plot <- data.frame(pcoa_res$scores)
df_plot$pop <- pop(gl6_3)
var_exp <- pcoa_res$eig / sum(pcoa_res$eig) * 100

colores_pob <- c(
  "AR" = "#3d84a8", "AT" = "#5F9EA0", "CR" = "#ab6393", "GA" = "#76EEC6",
  "IP" = "#e6b8c1", "ME" = "#d96459", "NZ" = "#FAEBD7", "PE" = "#7c7a7e"
)

limite_inferior <- -8
limite_superior <- 10

p <- ggplot(df_plot, aes(x = PC1, y = PC2, color = pop)) +
  annotate("rect", xmin = -Inf, xmax = 0, ymin = -Inf, ymax = Inf,
           fill = "grey95", alpha = 0.5) +
  annotate("rect", xmin = -Inf, xmax = 0, ymin = 9, ymax = 10,
           fill = "#84a9ac", alpha = 0.8) +
  annotate("rect", xmin = 0, xmax = Inf, ymin = 9, ymax = 10,
           fill = "#f9f1a5", alpha = 0.8) +
  geom_point(size = 4, alpha = 0.8) +
  scale_color_manual(values = colores_pob) +
  scale_y_continuous(limits = c(limite_inferior, limite_superior), expand = c(0, 0)) +
  labs(
    x = paste0("PCoA axis 1 (", round(var_exp[1], 1), "%)"),
    y = paste0("PCoA axis 2 (", round(var_exp[2], 1), "%)"),
    color = "Población"
  ) +
  theme_bw() +
  theme(
    panel.grid = element_blank(),
    legend.title = element_text(face = "bold"),
    axis.title = element_text(size = 11),
    plot.margin = margin(t = 25, r = 10, b = 10, l = 10)
  ) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "grey70") +
  geom_vline(xintercept = 0, linetype = "dashed", color = "grey70") +
  coord_cartesian(clip = "off")

print(p)
ggsave("PCoA_estructura.png", plot = p, width = 12, height = 7, dpi = 300)

