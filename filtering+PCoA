library(dartR)
library(adegenet)   # para DAPC más adelante si lo necesitas

# Cargar solo genotipos
gl_v3 <- gl.read.dart(filename = "Report_DStu19-4381_SNP_mapping_1.csv")

# Metadatos en un objeto aparte
#sep = "\t" se usa en funciones como read.table() para cargar archivos donde las columnas están separadas por tabulaciones.
meta_temp <- read.table("iddata_fgg.txt", header = TRUE, sep = "\t")

# Primera columna sea 'id' y coincida con los genotipos
#El orden de los IDs en el .txt debe ser el mismo que en el .csv
colnames(meta_temp)[1] <- "id"

# Asignación de metadatos manualmente al objeto genlight
gl_v3@other$ind.metrics <- meta_temp

# Lista los nombres de los objetos guardados en 'other'
names(gl_v3@other)

# Se asigna el nombre de la columna de población ('pop')
pop(gl_v3) <- meta_temp$pop

# Verificar si el objeto es válido
print(gl_v3)

# Genlight object
nLoc(gl_v3)        #number of loci 74339
nInd(gl_v3)        #number of individuals 187
nPop(gl_v3)        #number of populations 9
levels(pop(gl_v3)) #populations
popNames(gl_v3)    #populations
table(pop(gl_v3))

## Filtros de calidad (dartR) ----------------------------------------------
# 2) Filter by reproducibility (RepAvg)
gl1 <- gl.filter.reproducibility(gl_v3, threshold = 1.00, verbose = 3) #siempre 0.99
gl1 #55,454 SNPs

# 3) Filtro por MAF > 0.01
gl2 <- gl.filter.maf(gl1,
                     threshold = 0.01,
                     verbose   = 3)

gl2 #39,103 SNPs
# --maf 0.05, indica: "Solo quédate con los SNPs donde el alelo raro aparezca en al menos el 5% del total de alelos de la población".

# ) Filter by locus
gl3 <- gl.filter.callrate(gl2, method = "loc", threshold = 0.85, verbose=3) #remocion de loci con mas de 10% de datos faltantes
gl3 # 13,900 loci

# 4) Filter per individual
gl4 <- gl.filter.callrate(gl3, method="ind", threshold = 0.90, recalc = TRUE, mono.rm = TRUE)  #remocion de individuos con mas de 15% de datos faltantes.
gl4 #159 ind,  13,886 loci

# 5) Filter by monomorphic loci
gl5 <- gl.filter.monomorphs(gl4)
gl5 #13,886 loci

# 6) Eliminar SNPs secundarios (fragmentos con >1 SNP)
gl6_3 <- gl.filter.secondaries(gl5)
gl6_3 #12,941 SNPs, 159 ind

#agregado 30-03-2026
