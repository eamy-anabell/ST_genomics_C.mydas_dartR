library(dartR)
library(adegenet)   # para DAPC más adelante

# 1. Cargar archivo actual
test <- read.table("cm_pop.txt", header = TRUE)

# 2. Nombres y población en columnas separadas
colnames(test) <- c("id", "pop")

# 3. Se guarda una versión limpia en formato CSV
# dartR prefiere CSV para evitar líos de tabulaciones
write.csv(test, "meta_limpio.csv", row.names = FALSE)

# 4. Se cargan datos de DArT con este nuevo archivo
gl <- gl.read.dart(filename = "Report_DStu19-4381_SNP_mapping_1.csv", 
                   ind.metafile = "meta_limpio.csv")
gl

## Filtros de calidad (dartR) ----------------------------------------------
# 2) Filter by reproducibility (RepAvg)
gl1 <- gl.filter.reproducibility(gl, threshold = 1.00, verbose = 3) #siempre 0.99
gl1

# Genlight object
gl2 <- gl.filter.maf(gl1, threshold = 0.01, verbose = 3)

gl2

# 3) Filter by locus
gl3 <- gl.filter.callrate(gl2, method = "loc", threshold = 0.85, verbose=3) #remocion de loci con mas de 10% de datos faltantes
gl3 

# 4) Filter per individual
gl4 <- gl.filter.callrate(gl3, method="ind", threshold = 0.90, recalc = TRUE, mono.rm = TRUE)  #remocion de individuos con mas de 15% de datos faltantes.
gl4 #158 ind, 11,836  loci

# gl4 es el dataset filtrado según el paper
nInd(gl4)  #158 individuos 
nLoc(gl4)  #11,836  locis

# 5) Filter by monomorphic loci
gl5 <- gl.filter.monomorphs(gl4)
gl5 

# 6) Eliminar SNPs secundarios (fragmentos con >1 SNP)
gl6 <- gl.filter.secondaries(gl5)
gl6

#agregado 30-03-2026
saveRDS(gl6, file = "gl6_v6_filtrado_call.rds")

#--------------------------------------------------------------------------
# Ver las poblaciones y número de individuos
table(pop(gl6))

