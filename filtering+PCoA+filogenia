# ------------------------------------------------------------
# 1. Comprobar dataset
# ------------------------------------------------------------

gl10_NCEPGL

nInd(gl10_NCEPGL)
nLoc(gl10_NCEPGL)


# ------------------------------------------------------------
# 2. Calcular distancia genética entre individuos
# ------------------------------------------------------------

dist_NCEPGL <- gl.dist.ind(
  gl10_NCEPGL,
  method = "euclidean",
  verbose = 3
)


# ------------------------------------------------------------
# 3. Construir árbol Neighbor-Joining
# ------------------------------------------------------------

tree_NCEPGL <- nj(dist_NCEPGL)


# ------------------------------------------------------------
# 4. Visualizar
# ------------------------------------------------------------

dev.new(
  width = 14,
  height = 12
)

plot(
  tree_NCEPGL,
  type = "phylogram",
  cex = 0.5,
  label.offset = 0.01,
  main = "Neighbor-Joining - NCEPGL"
)

