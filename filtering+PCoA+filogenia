# ------------------------------------------------------------
# 2. Calcular distancia genética entre individuos
# ------------------------------------------------------------

dist_NCEPGL <- gl.dist.ind(
  gl10_NCEPGL,
  method = "euclidean",
  verbose = 3
)


# ------------------------------------------------------------
# 3. Construir árbol Neighbor-Joining
# ------------------------------------------------------------

tree_NCEPGL <- nj(dist_NCEPGL)


# ------------------------------------------------------------
# 4. Visualizar
# ------------------------------------------------------------

dev.new(
  width = 14,
  height = 12
)

plot(
  tree_NCEPGL,
  type = "phylogram",
  cex = 0.5,
  label.offset = 0.01,
  main = "Neighbor-Joining - NCEPGL"
)

#----------------------------------------------------------------------

library(adegenet)

# 1. Encontrar el número de grupos (K)
# Te pedirá elegir el K. Elige el que tenga el valor de BIC más bajo en el gráfico.
clusters <- find.clusters(gl10_NCEPGL, max.n.clust = 10, n.pca = 100, choose.n.clust = TRUE)

# 2. Ejecutar el DAPC
# Selecciona suficientes PCs para retener el 80-90% de la varianza (ej. 50-80)
dapc1 <- dapc(gl10_NCEPGL, clusters$grp, n.pca = 60, n.da = 2)

# 3. Ver el gráfico de asignación (Compoplot)
# Esto te dirá si hay individuos "mezclados" (híbridos) entre linajes
compoplot(dapc1, col=funky(5), main="Asignación Genética por Individuo")

